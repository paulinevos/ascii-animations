#!/usr/bin/env python3
"""Run an animation by name.

    animate sunset_gradient
    animate divider_gradient divider_green.txt

Any further arguments are passed on to the animation. With no name, or with a
name that does not exist, it lists what is available. Ctrl-C to stop.
"""

import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
EXTENSION = ".py"


def animations():
    """The runnable animations, by the name you pass to this command."""
    return sorted(
        entry[: -len(EXTENSION)]
        for entry in os.listdir(HERE)
        if entry.endswith(EXTENSION)
    )


def usage():
    lines = ["Usage: animate <animation> [arguments...]", "", "Animations:"]
    lines.extend(f"    {animation}" for animation in animations())
    return "\n".join(lines)


def run(animation, arguments):
    script = os.path.join(HERE, f"{animation}{EXTENSION}")
    if not os.path.isfile(script):
        sys.exit(f"There is no animation named {animation!r}.\n\n{usage()}")
    # Hand the terminal over rather than spawning a child: the animation then
    # owns this process, so Ctrl-C, output buffering and cursor handling behave
    # exactly as they do when the script is run directly.
    os.execv(sys.executable, [sys.executable, script, *arguments])


def main():
    if len(sys.argv) < 2:
        sys.exit(usage())
    run(sys.argv[1], sys.argv[2:])


if __name__ == "__main__":
    main()
